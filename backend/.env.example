NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taxserves_db
JWT_SECRET=your_jwt_secret_here
STORAGE_TYPE=local
UPLOAD_DIR=./public/uploads
LOW_STOCK_THRESHOLD=10
CLOUD_STORAGE_URL=https://your-cloud-bucket-url
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=SR Selections
UPI_QR_IMAGE_URL=/uploads/payments/qr-code.png

# Application URLs (for Cashfree callbacks)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Cashfree Payment Gateway (Sandbox)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_BASE_URL=https://sandbox.cashfree.com
# CASHFREE_BASE_URL=https://api.cashfree.com
CASHFREE_WEBHOOK_SECRET=

# Temporary Live Payment Test Mode
# WARNING: Only enable this for controlled live payment testing.
# When LIVE_PAYMENT_TEST_MODE=true, all Cashfree live orders are charged
# exactly LIVE_PAYMENT_TEST_AMOUNT INR instead of the real cart total.
# Set to false and remove/comment these lines before real customer payments.
LIVE_PAYMENT_TEST_MODE=false
LIVE_PAYMENT_TEST_AMOUNT=1.00