{
  "name": "taxserves-backend",
  "version": "1.0.0",
  "description": "TaxServes e-commerce backend with PostgreSQL",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node -r dotenv-flow/config node_modules/.bin/node-pg-migrate up",
    "migrate:down": "node -r dotenv-flow/config node_modules/.bin/node-pg-migrate down",
    "db:create": "node scripts/create-db.js",
    "db:drop": "node scripts/drop-db.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js reset"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv-flow": "^4.1.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-pg-migrate": "^7.7.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
